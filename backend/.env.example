# ============ 复制为 .env 后按需修改 ============

# 运行环境：dev / prod
FLASK_ENV=dev
SECRET_KEY=change-me-in-production
HOST=0.0.0.0
PORT=5000

# ---------- 数据源根目录（9 个数据集所在位置）----------
DATA_ROOT=../../航班延误预测数据源

# ---------- 数仓（Parquet 分区目录）----------
WAREHOUSE_ROOT=./data/warehouse
STAGING_ROOT=./data/staging
MODEL_ROOT=./data/models

# ---------- 计算引擎：auto / pandas / spark ----------
# auto = 有 pyspark 且 JVM 可用时用 Spark，否则用 pandas；当前 ETL 核心仍在单机执行
QUERY_ENGINE=auto
SPARK_MASTER=local[6]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=4g
SPARK_SQL_SHUFFLE_PARTITIONS=64

# ---------- MySQL 8.0（业务库与账户）----------
# 生产：mysql+pymysql://root:123456@127.0.0.1:3306/flight_delay?charset=utf8mb4
# 开发不配则自动落到 instance/flight_delay.db（SQLite）
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/flight_delay?charset=utf8mb4
DATABASE_URL=

# ---------- Redis 缓存（不配则用进程内 LRU 缓存）----------
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_DASHBOARD=600
CACHE_TTL_QUERY=300

# ---------- 认证 ----------
JWT_TTL_HOURS=8
JWT_ISSUER=flight-delay-system

# ---------- 指标体系口径 ----------
# 准点阈值（分钟）：起飞延误 < 该值视为准点
ONTIME_THRESHOLD_MIN=15
# 严重延误阈值（分钟）
SEVERE_DELAY_MIN=60
# 延误值域（超出仅标记 outlier，不删除）
DELAY_MIN_BOUND=-300
DELAY_MAX_BOUND=1500

# ---------- 接入约束 ----------
STAGING_MAX_BYTES=52428800
ZIP_MAX_INFLATE_BYTES=2147483648
ZIP_MAX_ENTRY_BYTES=524288000
MAX_PAGE_SIZE=200
EXPORT_MAX_ROWS=1000

# ---------- 固定随机种子（可复现）----------
RANDOM_SEED=42

# ---------- DeepSeek AI 分析助手 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
